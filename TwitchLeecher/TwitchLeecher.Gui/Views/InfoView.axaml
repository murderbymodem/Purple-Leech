<UserControl x:Class="TwitchLeecher.Gui.Views.InfoView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:TwitchLeecher.Gui.ViewModels"
             x:DataType="viewModels:InfoViewModel">
    <Design.DataContext>
        <viewModels:InfoViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="Button.hyperlink">
            <Setter Property="Foreground" Value="Blue" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}">
                        <ContentPresenter.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
                                <Setter Property="FontSize" Value="{TemplateBinding FontSize}" />
                                <Setter Property="TextDecorations" Value="Underline" />
                            </Style>
                        </ContentPresenter.Styles>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="{Binding ProductName, Mode=OneTime, FallbackValue='Twitch Leech X.Y'}"
                           FontWeight="Bold" FontSize="20" VerticalAlignment="Top" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Developers" FontWeight="Bold" Margin="0,15,0,0" />
            <TextBlock Grid.Row="2" Text="murderbymodem" Margin="15,5,0,0" />
            <TextBlock Grid.Row="3" Margin="15,5,0,0"
                       Text="Based on work by Dominik &quot;Franiac&quot; Rebitzer and Manuel &quot;Brainy&quot; Schneider" />

            <TextBlock Grid.Row="4" Text="Support &amp; Issues" FontWeight="Bold" Margin="0,15,0,0" />
            <TextBlock Grid.Row="5" Margin="15,5,0,0">
                <Button Classes="hyperlink" Command="{Binding OpenLinkCommand}"
                        CommandParameter="https://github.com/murderbymodem/Twitch-Leech/issues">
                    https://github.com/murderbymodem/Twitch-Leech/issues
                </Button>
            </TextBlock>

            <TextBlock Grid.Row="6" Text="Source Code &amp; Documentation" FontWeight="Bold" Margin="0,15,0,0" />
            <TextBlock Grid.Row="7" Margin="15,5,0,0">
                <Button Classes="hyperlink" Command="{Binding OpenLinkCommand}"
                        CommandParameter="https://github.com/murderbymodem/Twitch-Leech">
                    https://github.com/murderbymodem/Twitch-Leech
                </Button>
            </TextBlock>

        </Grid>
    </ScrollViewer>
</UserControl>